# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is gitignored (D-06) and must never be committed.
# docker compose reads this file automatically from the repo root.

# --- docker compose: local PostgreSQL (D-05) ---------------------------------
POSTGRES_DB=procurement_radar
POSTGRES_USER=procurement_radar
# No default. Generate one, for example: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Loopback only. Change to 0.0.0.0 to expose the database to the local network.
POSTGRES_BIND_ADDRESS=127.0.0.1

# --- application (D-06) ------------------------------------------------------
# Must match the POSTGRES_* values above.
PR_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=procurement_radar;Username=procurement_radar;Password=

# Root of the local archive: raw fetch bodies and downloaded documents (D-04).
#
# Make this an absolute path. It is resolved against the working directory, and
# the worker does not run from the same one twice: from a shell it is the repo,
# from the scheduled task it is publish/. A relative path quietly splits the
# archive in two - which is what happened here, 1055 files under publish/data
# and 2 under data/ - and architecture rule 2 says the archive is the one thing
# that must not be lost. The paths in raw_fetch.body_path are relative to this
# root, so moving the tree and repointing this variable is all a move takes.
PR_DATA_DIR=C:/full/path/to/procurement-radar-kit/data

# Telegram bot token from @BotFather.
PR_TELEGRAM_BOT_TOKEN=

# Numeric id of the group the bot posts to. Negative for groups.
PR_TELEGRAM_CHAT_ID=

# Sent in the User-Agent header so authorities can reach us. Use a real address.
PR_CONTACT_EMAIL=

# Header token for the local interface api (D-16). Any long random string.
PR_API_TOKEN=
