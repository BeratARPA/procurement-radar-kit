{
  "openapi": "3.0.1",
  "info": {
    "title": "Procurement Radar",
    "description": "The local api behind the interface (D-16). Runs on the machine that collects, reachable on the home network, and every request wants the X-Api-Token header.",
    "version": "v1"
  },
  "paths": {
    "/api/awards": {
      "get": {
        "tags": [
          "Awards"
        ],
        "summary": "Concluded tenders, newest first, with the estimate beside the contract.",
        "description": "The pair is the point: 3.405.000 estimated, 3.300.000 signed, one bid.\r\nA notice says what is wanted; only this says what it goes for.",
        "operationId": "listAwards",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AwardSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/awards/pending": {
      "get": {
        "tags": [
          "Awards"
        ],
        "summary": "Tenders that have closed and whose result has not been read yet.",
        "description": "So that an empty results screen can say why it is empty. This table fills\r\nslowly on purpose - D-15 asks EKAP about five tenders every six hours,\r\nand only for notices with an IKN whose deadline passed a fortnight ago,\r\nbecause the result announcement goes up after the contract is signed.\r\nWithout this number, a screen with nothing on it looks broken rather than\r\nearly.",
        "operationId": "listPendingAwards",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AwardCandidate"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/filter/preview": {
      "post": {
        "tags": [
          "Filter"
        ],
        "summary": "What this keyword list and threshold would have announced.",
        "description": "D-14 moved the threshold from 60 to 30 by reading a sample by hand. The\r\nsame question is a second's work here and exact: against the archive as it\r\nstands, 60 announces 2 notices, 30 announces 14, 25 announces 19.\r\n            \r\nNothing is written. The scorer is built from the submitted list and thrown\r\naway, so a preview cannot change what the worker is doing - which would be\r\nthe opposite of a preview.",
        "operationId": "previewFilter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilterPreviewRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/FilterPreviewRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/FilterPreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilterPreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Active sources, failing sources, notice counts and the last fetch.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/notices": {
      "get": {
        "tags": [
          "Notices"
        ],
        "summary": "Notices, still open by default and the whole archive on request.",
        "description": "The open list is the right answer for a notification and a narrow one for\r\na screen: Telegram already applies the filter, so an interface that only\r\never shows what passed it is a second funnel over the same water.\r\n`scope=all` hands over everything and lets the reader narrow it.",
        "operationId": "listNotices",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Searches title and authority across the whole archive.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "description": "open (default) or all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minScore",
            "in": "query",
            "description": "Applies to both scopes; ignored when a term is given.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Capped at 5000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandNotice"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/notices/closing": {
      "get": {
        "tags": [
          "Notices"
        ],
        "summary": "Notices closing within the window, soonest first.",
        "operationId": "listClosingNotices",
        "parameters": [
          {
            "name": "withinHours",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandNotice"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/notices/by-id/{id}": {
      "get": {
        "tags": [
          "Notices"
        ],
        "summary": "One notice by its own id, announcement text included.",
        "description": "This is the one a list links to. Only EKAP issues an IKN, so most of the\r\narchive has none - 814 of the first 924 notices - and a screen keyed on the\r\nIKN could open about one notice in eight.",
        "operationId": "getNotice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id every list row carries.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/notices/{ikn}": {
      "get": {
        "tags": [
          "Notices"
        ],
        "summary": "One notice by its tender registration number, announcement text included.",
        "operationId": "getNoticeByIkn",
        "parameters": [
          {
            "name": "ikn",
            "in": "path",
            "description": "For example 2026/1166872.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/notices/{id}/status": {
      "post": {
        "tags": [
          "Notices"
        ],
        "summary": "Records the team's verdict on a notice.",
        "description": "These verdicts are what makes the threshold measurable later (spec section\r\n10): if what was dismissed and what was pursued score the same, the filter\r\nis not discriminating.",
        "operationId": "changeNoticeStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChangeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChangeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChangeRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Every setting, with when it last changed and by whom.",
        "operationId": "listSettings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Setting"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/{key}": {
      "get": {
        "tags": [
          "Settings"
        ],
        "operationId": "getSetting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "keywords, messages, date_patterns, normalization, personal_data, award_labels, ekap_ui or politeness.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setting"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Replaces a setting, filing the previous value in the history.",
        "description": "Validated by the loader that will read it, not by a second description of\r\nwhat valid looks like: two validators drift, one cannot. The politeness\r\nsetting is refused below five seconds between requests to a host, and with\r\nrobots.txt turned off, whoever is asking (D-16).\r\n            \r\nThe worker would survive a bad value - it keeps the previous one and logs\r\nan error - but the person who pressed save would never hear about it.",
        "operationId": "saveSetting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingChangeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingChangeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SettingChangeRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/{key}/history": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Previous values, newest first.",
        "description": "One mistyped keyword silences the notifications and nothing about the\r\nsystem looks broken while it happens. A settings screen that cannot be\r\nundone is worse than no settings screen.",
        "operationId": "getSettingHistory",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Setting"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Sources currently in the rotation.",
        "operationId": "listActiveSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "Registers a source, or refreshes the definition of the one at that url.",
        "description": "A new source is created **switched off**. spec Bolum 5 ends its\r\nprocedure with three days of observation before `is_active = true`, and a\r\nscreen that skipped straight to polling would skip the one step that\r\ncatches a bad selector before it burns politeness budget. Switching it on\r\nis a separate, deliberate press.",
        "operationId": "saveSource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceSavedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/all": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Every source, switched-off ones included.",
        "description": "The collector only ever wants the active ones; a person wants all of them.\r\nTwenty-five are registered and off, each with its reason in its notes, and\r\none was switched off automatically after ten consecutive failures with no\r\nway to see it afterwards.",
        "operationId": "listAllSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/troubled": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Sources that are failing or have gone quiet.",
        "operationId": "listTroubledSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceHealth"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}": {
      "get": {
        "tags": [
          "Sources"
        ],
        "operationId": "getSource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Sources"
        ],
        "summary": "Edits a source that already exists, url included.",
        "description": "Leaves the rotation and the health columns alone: editing a selector must\r\nnot be able to switch a source back on or clear the failure count that\r\ntook it out.",
        "operationId": "updateSource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SourceDefinitionRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/check": {
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "What a set of selectors would find on a page.",
        "description": "Nothing is fetched and nothing is written. The page comes from the\r\narchive - the one the collector actually got - or from the request, so\r\ntrying a selector costs the authority nothing.",
        "operationId": "checkSource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCheckRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCheckRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}/active": {
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "Puts a source in or out of the rotation.",
        "description": "Activating clears the failure count as well. Leaving it at ten would take\r\nthe source straight back out on its next stumble, and the reason it failed\r\nten times is usually the thing that was just fixed.",
        "operationId": "setSourceActive",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveChangeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveChangeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveChangeRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveChangeRequest": {
        "required": [
          "isActive"
        ],
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "description": "True puts the source back in the rotation and clears its failure count."
          }
        },
        "additionalProperties": false
      },
      "AuthorityType": {
        "enum": [
          "university",
          "municipality",
          "provincial_directorate",
          "hospital",
          "soe_subsidiary",
          "ekap"
        ],
        "type": "string"
      },
      "AwardCandidate": {
        "type": "object",
        "properties": {
          "noticeId": {
            "type": "integer",
            "format": "int64"
          },
          "ikn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AwardSummary": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authorityName": {
            "type": "string"
          },
          "winnerName": {
            "type": "string",
            "nullable": true
          },
          "contractAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "estimatedCost": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "bidCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "awardedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CheckedNotice": {
        "required": [
          "documentCount",
          "sourceUrl",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "bidDeadlineAt": {
            "type": "string",
            "description": "Null when the date could not be read from this row.",
            "format": "date-time",
            "nullable": true
          },
          "documentCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "One row an adapter config found on the page."
      },
      "CommandNotice": {
        "type": "object",
        "properties": {
          "noticeId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "authorityName": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "bidDeadlineAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FilterPreviewRequest": {
        "required": [
          "keywords"
        ],
