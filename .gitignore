# --- Local data (D-04, D-05) -------------------------------------------------
# Raw fetch archive, downloaded documents and the PostgreSQL volume all live
# here. Never committed. Backup is manual: weekly tar czf to a second disk.
#
# The three paths are written out rather than a bare `data/`, which matches a
# directory of that name at any depth. It matched ui/lib/src/data - the
# connection store, the failure mapping, the notice filter and every Riverpod
# provider - so four files the interface cannot start without were never in the
# repository and a fresh clone would not have built. Nothing said so, because
# `git add -A` reports no error for a path it has been told to ignore.
#
# PR_DATA_DIR defaults to ./data, relative to whatever the working directory is:
# the repository root for the cli, the project directory under `dotnet run`, and
# publish/ once deployed.
/data/
/src/*/data/
/publish/data/

# --- Per-machine compose overrides -------------------------------------------
# Local-only tweaks such as the Windows named-volume workaround. Never shared.
docker-compose.override.yml

# --- Serilog output (D-07) ---------------------------------------------------
# Daily rolling files, 30 days retained. Written next to the working directory.
logs/

# --- Secrets (D-06) ----------------------------------------------------------
.env
*.env.local

# --- .NET build output -------------------------------------------------------
bin/
obj/
artifacts/
*.nupkg

# --- Test and tooling output -------------------------------------------------
TestResults/
*.trx
*.coverage
coverage/

# --- IDE / editor ------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userprefs

# --- Claude Code local overrides ---------------------------------------------
.claude/settings.local.json

# --- OS noise ----------------------------------------------------------------
Thumbs.db
.DS_Store

# Playwright's browser (T-16). ~300 MB of Chromium that the installer downloads
# on each machine. It is a dependency, not source; committing it would put a
# browser in every clone and in every diff.
.playwright/

# Output of deploy/install-windows.ps1. Built from the source beside it.
publish/
