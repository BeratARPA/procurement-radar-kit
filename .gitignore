# --- Local data (D-04, D-05) -------------------------------------------------
# Raw fetch archive, downloaded documents and the PostgreSQL volume all live
# here. Never committed. Backup is manual: weekly tar czf to a second disk.
data/

# --- Per-machine compose overrides -------------------------------------------
# Local-only tweaks such as the Windows named-volume workaround. Never shared.
docker-compose.override.yml

# --- Serilog output (D-07) ---------------------------------------------------
# Daily rolling files, 30 days retained. Written next to the working directory.
logs/

# --- Secrets (D-06) ----------------------------------------------------------
.env
*.env.local

# --- .NET build output -------------------------------------------------------
bin/
obj/
artifacts/
*.nupkg

# --- Test and tooling output -------------------------------------------------
TestResults/
*.trx
*.coverage
coverage/

# --- IDE / editor ------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userprefs

# --- Claude Code local overrides ---------------------------------------------
.claude/settings.local.json

# --- OS noise ----------------------------------------------------------------
Thumbs.db
.DS_Store

# Playwright's browser (T-16). ~300 MB of Chromium that the installer downloads
# on each machine. It is a dependency, not source; committing it would put a
# browser in every clone and in every diff.
.playwright/

# Output of deploy/install-windows.ps1. Built from the source beside it.
publish/
