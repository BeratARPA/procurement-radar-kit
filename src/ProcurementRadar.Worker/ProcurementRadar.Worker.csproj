<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- The long-running host: scheduling, polling, parse pipeline, notification
       and health checks. Runs under systemd with Restart=always (D-10). -->

  <ItemGroup>
    <ProjectReference Include="..\ProcurementRadar.Domain\ProcurementRadar.Domain.csproj" />
    <ProjectReference Include="..\ProcurementRadar.Persistence\ProcurementRadar.Persistence.csproj" />
    <ProjectReference Include="..\ProcurementRadar.Collector\ProcurementRadar.Collector.csproj" />
    <ProjectReference Include="..\ProcurementRadar.Parsers\ProcurementRadar.Parsers.csproj" />
    <ProjectReference Include="..\ProcurementRadar.Scoring\ProcurementRadar.Scoring.csproj" />
    <ProjectReference Include="..\ProcurementRadar.Notifier\ProcurementRadar.Notifier.csproj" />
  </ItemGroup>

  <!-- Not appsettings.json, and the name is the whole point. The installer
       publishes the worker and the api into one folder so they share config/
       and .env, and two projects cannot both own a file called
       appsettings.json: the second publish overwrites the first. The worker
       lost its log path, its Application name and two thirds of its retention
       that way, and both processes then tried to write the same file - which is
       why one day had seven of them, Serilog opening _001, _002 and so on each
       time it found the last one locked. -->
  <ItemGroup>
    <Content Update="appsettings.worker.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <UserSecretsId>dotnet-ProcurementRadar.Worker-0b401d99-4840-49fe-a616-94ac0109aa36</UserSecretsId>
  </PropertyGroup>

</Project>
