<Project Sdk="Microsoft.NET.Sdk">

  <!-- DbUp runner. Stays independent of the rest of the solution on purpose:
       the migration scripts are the schema's only source of truth (D-02). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dd134102-11b4-42f3-809a-5bca8613c501</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- D-02: scripts ship inside the assembly, so the migrator is one
         self-contained command. They stay plain .sql files that can also be run
         by hand in psql when something needs untangling. -->
    <EmbeddedResource Include="Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
